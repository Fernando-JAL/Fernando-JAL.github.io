---
import Layout from "../layouts/Layout.astro";
import { credentials } from "../data/portfolio";
---

<Layout title="Education | Fernando Alcantara Lopez" description="Academic training and recent technical courses completed by Fernando Alcantara Lopez." path="/credentials">
  <main>
    <section class="page-intro mx-auto max-w-6xl px-6 py-24" aria-labelledby="credentials-heading"><p class="eyebrow">EDUCATION</p><h1 id="credentials-heading">What I studied and what I keep learning.</h1><p>A mathematics foundation, plus practical training in data science, software engineering, and scientific workflows.</p></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="education-heading"><div class="section-intro"><p class="eyebrow">01 / DEGREE</p><h2 id="education-heading">Mathematical sciences</h2></div><article class="philosophy-panel"><p><strong>Ph.D. in Mathematical Sciences</strong> · National Autonomous University of Mexico (UNAM), 2018–2023</p><p><strong>M.Sc. in Mathematical Engineering</strong> · Autonomous University of Querétaro (UAQ), 2013–2015</p><p><strong>B.Sc. in Applied Mathematics</strong> · Autonomous University of Querétaro (UAQ), 2007–2011</p><p>My academic background taught me to handle complex problems, reason carefully, and communicate technical results clearly.</p></article></section>
    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="certifications-heading"><div class="section-intro"><p class="eyebrow">02 / COURSES</p><h2 id="certifications-heading">Recent learning.</h2><p>Courses that support my current work in data, software, and machine learning.</p></div><div class="certs-grid">{credentials.map((credential) => <article class="cert-card"><div class="cert-year">{credential.year}</div><h3>{credential.name}</h3><p class="cert-issuer">{credential.issuer}</p><p class="cert-desc">{credential.description}</p></article>)}</div></section>
  </main>
</Layout>