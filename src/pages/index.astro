---
import Layout from "../layouts/Layout.astro";
import { metrics } from "../data/portfolio";
---

<Layout title="Fernando Alcantara Lopez | Software Engineer & Data Engineer" path="/">
  <main id="top">
    <section class="hero-section mx-auto max-w-6xl px-6" aria-labelledby="hero-heading">
      <div class="hero-grid-pattern" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Software Engineer • AI/ML • ADAS</p>
        <h1 id="hero-heading">I build <span class="gradient-text">reliable data-driven systems</span> for research and real-world engineering.</h1>
        <p class="hero-lede">I combine software engineering, scientific computing, and machine learning to build solutions that are explainable, testable, and useful in production.</p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/experience" class="btn-primary">Experience <span aria-hidden="true">↓</span></a>
          <a href="/projects" class="btn-secondary">Projects <span aria-hidden="true">→</span></a>
          <a href="/scientific-products" class="btn-secondary">Scientific Products <span aria-hidden="true">→</span></a>
          <a href="/architecture" class="btn-secondary">Architecture <span aria-hidden="true">→</span></a>
          <a href="/credentials" class="btn-secondary">Credentials <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-meta"><span class="meta-divider"></span><span>Ph.D. in Mathematical Sciences · Querétaro, México</span><span class="meta-divider"></span></div>
      </div>
      <aside class="hero-visual" aria-label="Fernando Alcantara Lopez engineering identity">
        <div class="hero-visual__frame">
          <img src="/minimi.png" alt="Illustrated portrait of Fernando Alcantara Lopez working with engineering and data systems" />
          <div class="hero-visual__scanline" aria-hidden="true"></div>
          <div class="hero-visual__label hero-visual__label--top">RESEARCH • VALIDATION • ML</div>
          <div class="hero-visual__label hero-visual__label--bottom"><span class="status-dot"></span>FERNANDO JAL</div>
        </div>
        <div class="hero-visual__caption"><span>Personal identity:</span><strong>Code · Data · Research</strong></div>
      </aside>
    </section>

    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="impact-heading">
      <div class="section-intro"><p class="eyebrow">01 / AT A GLANCE</p><h2 id="impact-heading">A few useful numbers.</h2><p>Results from recent work.</p></div>
      <div class="impact-grid">
        {metrics.map((metric, index) => <div class:list={["impact-item", { "impact-item--featured": index === 0 }]}><strong>{metric.value}</strong><span>{metric.description}</span></div>)}
      </div>
    </section>

    <section class="section-band mx-auto max-w-6xl px-6" aria-labelledby="nav-heading">
      <div class="section-intro"><p class="eyebrow">02 / EXPLORE</p><h2 id="nav-heading">Jump to a section.</h2></div>
      <nav class="nav-grid" aria-label="Portfolio sections">
        <a href="/experience" class="nav-card">
          <h3>Experience</h3>
          <p>ADAS validation, scientific software, and software testing</p>
        </a>
        <a href="/projects" class="nav-card">
          <h3>Projects</h3>
          <p>Computer vision, scientific computing, and applied ML</p>
        </a>
        <a href="/scientific-products" class="nav-card">
          <h3>Scientific Products</h3>
          <p>Journal articles, theses, and conference research</p>
        </a>
        <a href="/architecture" class="nav-card">
          <h3>Architecture</h3>
          <p>Data workflows, validation pipelines, and engineering rigor</p>
        </a>
        <a href="/credentials" class="nav-card">
          <h3>Credentials</h3>
          <p>Math, data science, AI, and software fundamentals</p>
        </a>
      </nav>
    </section>

    <section class="closing-section mx-auto max-w-6xl px-6" aria-labelledby="contact-heading">
      <div class="closing-panel"><p class="eyebrow">03 / CONNECT</p><h2 id="contact-heading">Let's talk software.</h2><div class="mt-6 flex flex-wrap gap-4"><a href="https://www.linkedin.com/in/fernando-javier-alcantara-lopez/" target="_blank" rel="noopener noreferrer" class="btn-primary">LinkedIn <span aria-hidden="true">↗</span></a><a href="https://github.com/Fernando-JAL" target="_blank" rel="noopener noreferrer" class="btn-secondary">GitHub <span aria-hidden="true">↗</span></a><a href="mailto:alcantaralopezfernando@gmail.com" class="btn-secondary">Email <span aria-hidden="true">→</span></a></div></div>
    </section>
  </main>
</Layout>